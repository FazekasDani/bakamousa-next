# WordPress site base URL (no trailing slash)
# Example: https://example.com
WORDPRESS_BASE_URL=

# Optional: if WP REST API requires Basic Auth (not recommended for public)
# WORDPRESS_BASIC_AUTH_USER=
# WORDPRESS_BASIC_AUTH_PASS=

# Optional: enable fetching draft/private content (requires auth)
# WORDPRESS_INCLUDE_DRAFTS=false

# Public site URL used for metadata and canonical generation
# NEXT_PUBLIC_SITE_URL=https://bakamousa.com

# Google Tag Manager container ID. Set this only in production environments.
# NEXT_PUBLIC_GTM_ID=GTM-5ZQTVMCV
